# 복사해서 .env.local 로 쓰세요. 실제 키는 절대 커밋하지 않습니다.
# 저장소: 둘 다 채우면 Supabase, 비워 두면 data/attempts/ JSON 파일 (로컬 시연)
# Supabase 대시보드 > Project Settings > API Keys 에서 복사: secret 키(sb_secret_…) 또는 예전 service_role 키. 서버 전용, 절대 공개 금지
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LLM: BAZE API Gateway (OpenAI 호환). 키는 BAZE 대시보드 > API Gateway에서 발급
LLM_PROVIDER=baze
LLM_API_URL=https://api.baze.co/v1/gateway
LLM_API_KEY=
# 좋은 답이 필요한 곳 (답변 생성, 가채점)
LLM_MODEL=claude-opus-5
# 빠르고 싼 곳 (질문 분류, 개발 중 테스트)
LLM_MODEL_FAST=gpt-5.4-mini
# 🔄 수행평가 기준 설계·AI 1차 채점용 (없으면 LLM_MODEL)
LLM_MODEL_DEEP=claude-opus-5-5

# 교사 화면 로그인 코드 (해커톤용 간이 인증)
TEACHER_CODE=
